    (order_estimated_delivery_date::TIMESTAMP AT TIME ZONE 'America/Sao_Paulo' AT TIME ZONE 'America/New_York')
 as order_estimated_delivery_date_et

from "analytics"."raw"."orders"
    );
  
  
