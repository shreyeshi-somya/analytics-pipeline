 as order_delivered_customer_date_et
    , order_estimated_delivery_time
    , 
    -- Assume the input timestamp is America/Sao_Paulo and convert to target timezone
    (order_estimated_delivery_time::TIMESTAMP AT TIME ZONE 'America/Sao_Paulo' AT TIME ZONE 'America/New_York')
 as order_estimated_delivery_time_et

from "analytics"."raw"."orders"
    );
  
  
