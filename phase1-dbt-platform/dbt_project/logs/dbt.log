select
      count(*) as failures,
      count(*) != 0 as should_warn,
      count(*) != 0 as should_error
    from (
      -- ERROR: Too many canceled orders have delivery dates (> 5%)
-- This indicates a systemic data quality issue requiring investigation

with canceled_orders as (
    select count(*) as total_canceled
    from "analytics"."main_staging"."stg_orders"
    where order_status = 'canceled'
),

canceled_with_delivery as (
    select count(*) as count_with_delivery
    from "analytics"."main_staging"."stg_orders"
    where order_status = 'canceled'
      and (order_delivered_customer_date is not null 
           or order_sent_to_carrier_date is not null)
)

select 
    c.total_canceled,
    d.count_with_delivery,
    round((d.count_with_delivery::float / c.total_canceled * 100), 2) as issue_rate_pct,
    5.0 as threshold_pct,
    'Issue rate exceeds acceptable threshold' as message
from canceled_orders c
cross join canceled_with_delivery d
where (d.count_with_delivery::float / c.total_canceled) > 0.05
      
    ) dbt_internal_test
